# Copy to .env.local. Every key is optional.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Unset = fixture mode (sample conditions and vehicles, labelled SAMPLE DATA)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_TILESET_URL=https://pub-7ceb47f944ac4ddb9bac87b602eb42af.r2.dev/lod1/v3/tileset.json
