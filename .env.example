# Copy to .env and fill in. Never commit .env.
# Local PostGIS used for tile building (docker-compose.yml)
POSTGRES_USER=clydetwin
POSTGRES_PASSWORD=clydetwin_local
POSTGRES_DB=clydetwin
POSTGRES_PORT=5433

# Phase 1 web (filled by the owner, not by agents)
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Tileset URL (local sample: make serve-tiles); production points at Cloudflare R2
NEXT_PUBLIC_TILESET_URL=http://localhost:8081/lod1/tileset.json
# Own quantized-mesh terrain (layer.json base or full URL; local: make serve-terrain). Preferred over ion terrain when set.
NEXT_PUBLIC_TERRAIN_URL=
# Google Map Tiles API key (official 2D tiles only). Leave empty to hide the Google basemaps. Restrict the key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Cloudflare R2 (publish-tiles, Phase 1 task 1.9)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clydetwin

# Phase 2 live stack (docker-compose.live.yml). Host tools (make migrate, pytest, collectors) use DATABASE_URL.
# Port 5434: 5433 is the P1 tile-build DB.
LIVE_DB_PASSWORD=change_me
LIVE_DB_PORT=5434
DATABASE_URL=postgresql://clydetwin:change_me@localhost:5434/clydetwin
# Public hostname served by Caddy (TLS). On the VM: <ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=localhost
# CORS for the API (comma-separated origins; regex for Vercel previews)
CORS_ORIGINS=http://localhost:3000,https://clydetwin.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Collectors to run: open-meteo, uk-air, sepa (SEPA KiWIS returns HTTP 429 per IP until access is granted)
LIVE_SOURCES=open-meteo,uk-air
# Aircraft (adsb.lol, ADR-008): add `adsb` to LIVE_SOURCES. Poll seconds, minimum 60; source switch.
# AIRCRAFT_INTERVAL_S=60
# AIRCRAFT_SOURCE=adsb.lol
# Optional Healthchecks.io ping URLs, one per source (name upper-cased, dashes to underscores)
HC_PING_OPEN_METEO=
HC_PING_UK_AIR=
HC_PING_SEPA=
# R2 (already above): the collectors container also writes a daily observation dump when R2_* is set
